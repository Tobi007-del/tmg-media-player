{
  "name": "tmg-media-player",
  "version": "0.0.21",
  "description": "A feature-rich, Web media player implementation for The Movie Garden initiative",
  "author": "Oketade Oluwatobiloba <tobioketade007@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tobi007-del/tmg-media-player.git"
  },
  "bugs": {
    "url": "https://github.com/Tobi007-del/tmg-media-player/issues"
  },
  "homepage": "https://github.com/Tobi007-del/tmg-media-player#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/super.global.js",
  "jsdelivr": "./dist/super.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "require": "./dist/init.cjs",
      "default": "./dist/init.js"
    },
    "./super": {
      "types": "./dist/super.d.ts",
      "import": "./dist/super.js",
      "require": "./dist/super.cjs",
      "default": "./dist/super.js"
    },
    "./style.css": "./dist/index.css",
    "./assets/*": "./dist/assets/*",
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "require": "./dist/core/*.cjs",
      "default": "./dist/core/*.js"
    },
    "./tools/*": {
      "types": "./dist/tools/*.d.ts",
      "import": "./dist/tools/*.js",
      "require": "./dist/tools/*.cjs",
      "default": "./dist/tools/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs",
      "default": "./dist/utils/*.js"
    },
    "./consts/*": {
      "types": "./dist/consts/*.d.ts",
      "import": "./dist/consts/*.js",
      "require": "./dist/consts/*.cjs",
      "default": "./dist/consts/*.js"
    },
    "./techs/*": {
      "types": "./dist/techs/*.d.ts",
      "import": "./dist/techs/*.js",
      "require": "./dist/techs/*.cjs",
      "default": "./dist/techs/*.js"
    },
    "./plugs/*": {
      "types": "./dist/plugs/*.d.ts",
      "import": "./dist/plugs/*.js",
      "require": "./dist/plugs/*.cjs",
      "default": "./dist/plugs/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    }
  },
  "scripts": {
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "build": "tsup",
    "build:super": "node scripts/build-super.js",
    "dev": "vite",
    "test": "echo \"Error: no test specified\" && exit 1",
    "change": "changeset",
    "bump": "changeset version",
    "release": "changeset publish"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/chrome": "^0.1.43",
    "@types/chromecast-caf-sender": "^1.0.11",
    "@types/node": "^25.9.1",
    "@types/youtube": "^0.2.0",
    "@vimeo/player": "^2.30.4",
    "dashjs": "^5.1.1",
    "esbuild-sass-plugin": "^3.6.0",
    "hls.js": "^1.6.16",
    "sass": "^1.98.0",
    "shaka-player": "^5.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@t007/dialog": "^0.0.36",
    "@t007/input": "^0.0.35",
    "@t007/toast": "^0.0.36",
    "@t007/utils": "^0.0.37",
    "jsdom": "^30.0.1",
    "jsdom-global": "^3.0.2",
    "sia-reactor": "^0.0.40"
  }
}
