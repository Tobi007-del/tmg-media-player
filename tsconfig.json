{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "preserveSymlinks": true,
    "types": ["node", "youtube", "chrome", "chromecast-caf-sender", "google_interactive_media_ads_types"],
    "paths": {
      // "@src": ["./src/*"],
      "@core/*": ["./src/ts/core/*"],
      "@defs/*": ["./src/ts/types/*"],
      "@tools/*": ["./src/ts/tools/*"],
      "@techs/*": ["./src/ts/techs/*"],
      "@plugs/*": ["./src/ts/plugs/*"],
      "@utils/*": ["./src/ts/utils/*"],
      "@consts/*": ["./src/ts/consts/*"],
      "@components/*": ["./src/ts/components/*"],
      "@styles/*": ["./src/css/*"]
    }
  },
  "include": ["src/**/*", "tool-box/boombox/**/*"]
}
